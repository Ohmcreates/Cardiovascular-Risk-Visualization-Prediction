# ==============================================================================
# CardioVision 3D - Environment Configuration Template
# Copy to .env for production customization
# ==============================================================================

# Application Environment ('production' | 'staging' | 'development')
ENVIRONMENT=production

# Server Port & Binding
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Default: Local SQLite database with WAL mode
DATABASE_URL=sqlite:///../data/cardiovision.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://cardiouser:securepassword@localhost:5432/cardiovision

# Machine Learning Engine Configuration
MODEL_DIR=../models
MODEL_VERSION=Cleveland-Ensemble-v1.0

# Security & CORS
ALLOWED_ORIGINS=*
SECRET_KEY=cardiovision-production-secret-key-change-in-prod
